{
  "name": "finite-automata-designer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:all": "npm run build:canvas && npm run dev",
    "dev:dfsm": "npm run build:dfsm && npm run dev",
    "dev:ndfsm": "npm run build:ndfsm && npm run dev",
    "build": "next build",
    "build:canvas": "rollup -c rollup.dfsm.config.js --forceExit && rollup -c rollup.ndfsm.config.js --forceExit",
    "build:dfsm": "rollup -c rollup.dfsm.config.js --forceExit",
    "build:ndfsm": "rollup -c rollup.ndfsm.config.js --forceExit",
    "build:prod": "npm run build:canvas && npm run build",
    "start": "next start",
    "lint": "eslint ."
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.55.0",
    "client-only": "^0.0.1",
    "next": "^16.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.4",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "rollup": "^4.55.1",
    "supabase": "^2.117.0",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
